# ── 共用資料庫設定範本 ──────────────────────────────────
# 用法：把這個檔複製成 .env（放在專案根目錄，與此檔同層），再填入實際值。
# .env 已被 .gitignore 忽略，不會上傳，請由負責人把填好的內容私下分享給組員。
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac / Linux:         cp .env.example .env
# ────────────────────────────────────────────────────────

# 共用雲端 Azure SQL Database 連線資訊（Azure Portal 建立 SQL Database 後填入）
DB_NAME=course_platform_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-server.database.windows.net
DB_PORT=1433

# 本機若未安裝 ODBC Driver 18 for SQL Server，先到微軟官網下載安裝；
# 驅動程式名稱不同時（例如 macOS 用 "ODBC Driver 18 for SQL Server" 也適用）可覆寫：
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# 開發時維持 True；正式部署再改 False
DEBUG=True

# 正式部署時建議換成自己的隨機字串；本機開發可留空使用預設
# SECRET_KEY=

# 課程封面／影片等上傳檔案改存 Azure Blob Storage（Storage Account）。
# 沒填的話會退回存在本機 myproject/media/，僅適合本機開發。
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=media

# 快速登入（Google / Microsoft / LINE Login）— 登入頁的按鈕一律會顯示，但沒填的話點下去
# 會被導回登入頁並顯示「尚未設定」，不影響帳號密碼登入等其他功能
# Google：https://console.cloud.google.com/apis/credentials 建立 OAuth 用戶端 ID，
#         已授權的重新導向 URI 填 http://127.0.0.1:8000/oauth/google/callback/
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft（供學生用學校或個人 Microsoft 帳號登入）：
# 到 https://entra.microsoft.com（Microsoft Entra 系統管理中心）→ 應用程式註冊 建立應用程式，
# Redirect URI 選 Web，填 http://127.0.0.1:8000/oauth/microsoft/callback/，
# 之後到「憑證與密碼」建立用戶端密碼。
# TENANT 預設 common（個人＋組織帳號皆可登入）；只想開放本校 Microsoft 365 帳號，
# 改填學校的 Tenant ID，或填 organizations（僅組織帳號、排除個人 Microsoft 帳號）。
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common

# LINE：https://developers.line.biz/console/ 建立 LINE Login channel，
#       Callback URL 填 http://127.0.0.1:8000/oauth/line/callback/
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=
