option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: myproject.settings
    PYTHONPATH: /var/app/current/myproject
  # nginx 直接送 /media（上傳圖：課程封面、大頭貼、首頁背景）與 /static（admin 靜態檔）。
  # 正式環境 Django 不送 /media，沒這段圖片會全部 404。
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /media: myproject/media
    /static: myproject/staticfiles

container_commands:
  # 只由部署 leader 套用尚未執行的 migration，避免多台 instance 同時改 schema。
  # `migrate` 可重複安全執行；沒有新 migration 時不會修改資料庫。
  01_migrate:
    command: "python myproject/manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "python myproject/manage.py collectstatic --noinput"
